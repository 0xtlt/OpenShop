{
  "name": "openshop-demo",
  "private": true,
  "type": "module",
  "imports": {
    "#app": "./openshop.app.ts",
    "#flows/*": "./flows/*.ts",
    "#functions/*": "./functions/*.ts",
    "#models/*": "./models/*.ts",
    "#providers/*": "./providers/*.ts",
    "#queries/*": "./queries/*.ts",
    "#routes/*": "./routes/*.ts",
    "#server/*": "./server/*.ts",
    "#webhooks/*": "./webhooks/*.ts"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "openshop dev",
    "build": "openshop build",
    "db:generate": "openshop migrate generate",
    "db:migrate": "openshop migrate",
    "db:check": "openshop migrate check",
    "db:status": "openshop migrate status",
    "codegen": "openshop codegen",
    "codegen:watch": "openshop codegen:watch",
    "shopify": "shopify app dev --config shopify.app.openshop-demo.toml --skip-dependencies-installation",
    "test": "openshop test",
    "lint": "pnpm run codegen && tsc --noEmit && eslint ."
  },
  "dependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/typescript": "6.1.2",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.4.0",
    "@shopify/api-codegen-preset": "3.0.0",
    "@shopify/graphql-codegen": "^0.1.0",
    "arktype": "^2.2.8",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "0.45.4",
    "openshop": "workspace:*",
    "pg": "^8.23.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@shopify/polaris-types": "^1.1.0",
    "@types/node": "^26.6.5",
    "eslint": "10.13.0",
    "typescript": "^6.0.3"
  }
}
