{
  "name": "__PACKAGE_NAME__",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "imports": {
    "#app": "./openshop.app.ts",
    "#flows/*": "./flows/*.ts",
    "#functions/*": "./functions/*.ts",
    "#models/*": "./models/*.ts",
    "#providers/*": "./providers/*.ts",
    "#queries/*": "./queries/*.ts",
    "#server/*": "./server/*.ts",
    "#webhooks/*": "./webhooks/*.ts"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "openshop dev",
    "build": "openshop build",
    "start": "openshop start",
    "worker": "openshop worker",
    "db:generate": "openshop migrate generate",
    "db:migrate": "openshop migrate",
    "db:check": "openshop migrate check",
    "db:status": "openshop migrate status",
    "codegen": "openshop codegen",
    "codegen:watch": "openshop codegen:watch",
    "shopify": "shopify app dev --skip-dependencies-installation",
    "test": "openshop test",
    "lint": "pnpm run codegen && tsc --noEmit && eslint ."
  },
  "dependencies": {
    "arktype": "^2.2.3",
    "openshop": "__OPENSHOP_VERSION__",
    "pg": "^8.23.0",
    "pm2": "^7.0.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@shopify/api-codegen-preset": "3.0.0",
    "@shopify/graphql-codegen": "^0.1.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "10.8.1",
    "typescript": "^6.0.3"
  }
}
